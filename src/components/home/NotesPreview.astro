---
import { getCollection } from 'astro:content';
import NoteCard from '../NoteCard.astro';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime()).slice(0,3);
---
<section class="section" id="notes"><div class="container">
  <div class="section-head notes-head"><div><span class="eyebrow">06 / NOTES &amp; THOUGHTS</span><h2 class="section-title">A space to share what I learn.</h2></div><p class="section-description">Writing about design decisions, creative processes, and the early steps of learning front-end development.</p></div>
  {notes.length ? <div class="entry-grid">{notes.map(note=><NoteCard note={note} />)}</div> : <div class="empty-notes"><h3>Notes are on the way.</h3><p>Articles and updates will appear here when they are ready.</p></div>}
  <div class="work-foot"><a class="text-link" href="/notes/">Explore all notes <span aria-hidden="true">↗</span></a></div>
</div></section>
