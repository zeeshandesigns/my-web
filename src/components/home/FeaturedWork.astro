---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../ProjectCard.astro';

const projectMap = new Map((await getCollection('projects', ({data}) => !data.draft)).map(p=>[p.id,p]));
const featuredSlugs = ['elite-top-guards', 'startex-marketing', 'pulse-real-estate', 'jp-beauty-studio'];
const featured = featuredSlugs.map(slug => projectMap.get(slug)).filter((p): p is CollectionEntry<'projects'> => p !== undefined);
---
<section class="section work work-editorial" id="work"><div class="container">
  <div class="section-head"><div><span class="eyebrow">01 / SELECTED WORK</span><h2 class="section-title">Selected Work, Made with Intention.</h2></div><p class="section-description">A curated mix of interfaces, brand thinking and visual campaigns. Two UI features and two social media placements, including a beauty campaign from J&amp;P Beauty Studio.</p></div>
  <div class="project-grid">{featured.map((project,index) => <ProjectCard project={project} index={index+1} featured />)}</div>
  <div class="work-foot"><a class="text-link" href="/work/">Explore the full portfolio <span aria-hidden="true">↗</span></a></div>
</div></section>
