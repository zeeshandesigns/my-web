---
import type { CollectionEntry } from 'astro:content';
interface Props { note: CollectionEntry<'notes'> }
const { note } = Astro.props;
const category = {article:'Article',insight:'Design Insight',learning:'Learning Log'}[note.data.category];
---
<a class="entry-card" href={`/notes/${note.id}/`}><span class="eyebrow">{category}</span><h3>{note.data.title}</h3><p>{note.data.description}</p><div class="article-meta"><time datetime={note.data.publishedAt.toISOString()}>{note.data.publishedAt.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</time>{note.data.tags.map(tag=><span>#{tag}</span>)}</div></a>
