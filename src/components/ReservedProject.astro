---
import ProjectVisual from './ProjectVisual.astro';
interface Props { number?: string }
const { number = '04 / 04' } = Astro.props;
---
<article class="project project-card-placeholder" data-type="social" data-placeholder="true" data-search="reserved social campaign">
  <ProjectVisual title="Selected social campaign" reserved />
  <div class="project-meta"><div><div class="project-name">Selected social campaign — coming soon</div><div class="project-desc">Real client project · To be selected</div><div style="margin-top:10px"><span class="tag">Social Media</span><span class="tag">Pending assets</span></div></div><span class="project-index">{number}</span></div>
</article>
