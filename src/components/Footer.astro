---
import { profile } from '../data/profile';
import { navigation, siteSettings } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer footer-studio" id="site-footer">
  <div class="container footer-studio-inner">
    <div class="footer-studio-top">
      <span class="footer-studio-availability"><span class="footer-status-light" aria-hidden="true"></span> Open to Remote &amp; International Opportunities</span>
      <a class="footer-to-top" href="#site-header" aria-label="Back to top of page">
        Back to Top
        <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true"><path d="M10 16V4m0 0-5 5m5-5 5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="footer-studio-feature">
      <div class="footer-studio-intro">
        <span class="footer-studio-kicker">DESIGN / THINKING / MAKING</span>
        <h2>Good Design.<br/><span>Meaningful Impact.</span></h2>
        <p>I bring visual thinking and a thoughtful approach to brands, interfaces and digital experiences. Always curious about what comes next.</p>
      </div>
      <div class="footer-studio-contact">
        <span class="footer-contact-label">HAVE A PROJECT OR OPPORTUNITY?</span>
        <a class="footer-contact-cta" href={`mailto:${profile.email}?subject=Design%20Opportunity%20for%20Zeeshan%20Haider`}>
          <span>Start a Conversation</span>
          <span class="footer-contact-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M5 19 19 5M8 5h11v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="footer-contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <span class="footer-contact-location">
          <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true"><path d="M16 8.2c0 4.1-6 9.1-6 9.1S4 12.3 4 8.2a6 6 0 1 1 12 0Z" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="8" r="2.2" stroke="currentColor" stroke-width="1.5"/></svg>
          {profile.city} <span aria-hidden="true">·</span> Working Worldwide
        </span>
      </div>
    </div>

    <div class="footer-studio-wordmark" aria-hidden="true">
      <span>Zeeshan</span><span class="footer-wordmark-dot">.</span>
      <span class="footer-wordmark-star">✳</span>
    </div>

    <div class="footer-studio-directory">
      <div class="footer-studio-identity">
        <a class="footer-studio-logo" href="/" aria-label="Zeeshan Haider — Homepage">ZH<span>.</span></a>
        <div><strong>{profile.name}</strong><span>Multidisciplinary Designer</span></div>
      </div>
      <nav class="footer-studio-navigation" aria-label="Footer navigation">
        {navigation.map(link => <a href={link.href}>{link.name}</a>)}
      </nav>
      <div class="footer-studio-socials" aria-label="Professional profiles">
        <a href={profile.linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={siteSettings.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="footer-studio-bottom">
      <span>© {year} {profile.name}. All Rights Reserved.</span>
      <span>Designed with Intention. Built to Evolve.</span>
      <a href="/privacy/">Privacy Policy <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</footer>
