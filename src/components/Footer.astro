---
import { profile } from '../data/profile';
import { navigation, siteSettings } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-content">
    <div><a href="/" class="footer-logo">{profile.name}<span>.</span></a><p class="footer-note">Multidisciplinary designer · {profile.city}<br/>Open to remote and international opportunities.</p></div>
    <nav aria-label="Footer links" class="footer-links">
      {navigation.map(link => <a href={link.href}>{link.name}</a>)}
      <a href="/privacy/">Privacy</a>
      <a href={siteSettings.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={`mailto:${profile.email}`}>Email ↗</a>
    </nav>
    <div class="footer-note">© {year} {profile.name}<br/>Designed with clarity. Built to grow.</div>
  </div>
</footer>
