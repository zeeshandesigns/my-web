---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SocialClientCard from '../../components/SocialClientCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { socialClients, industryFilters } from '../../data/socialClients';
import { getCollection } from 'astro:content';
const projects=(await getCollection('projects',({data})=>!data.draft)).sort((a,b)=>a.data.sortOrder-b.data.sortOrder);
const classic=projects.filter(p=>p.data.caseStudyType!=='social');
const social=projects.filter(p=>p.data.caseStudyType==='social');
const core=social.filter(p=>p.data.clientSlug && socialClients[p.data.clientSlug as keyof typeof socialClients]?.collection==='core');
const more=social.filter(p=>p.data.clientSlug && socialClients[p.data.clientSlug as keyof typeof socialClients]?.collection==='additional');
---
<BaseLayout title="Work" description="Browse Zeeshan Haider's design portfolio, including UI/UX, branding and social media campaign work across multiple industries.">
  <section class="page-hero work-gallery-hero"><div class="container">
    <div class="hero-columns"><div><span class="eyebrow">01 / THE PORTFOLIO</span><h1 class="page-title">Selected <span class="soft">Work.</span></h1>
    <p class="page-lead">Interfaces, identities and social media creatives across different industries. Select a project to explore it without leaving the gallery.</p></div>
    <div class="aside-note">Designs first. Every card opens a quick project preview. Use the compact filter at the bottom to narrow your selection.</div></div>
  </div></section>
  <section class="inner-section work-gallery-first"><div class="container">
    <section class="portfolio-work-group" data-project-section aria-labelledby="interface-heading">
      <div class="social-work-heading"><div><span class="eyebrow">01 / SELECTED PROJECTS</span><h2 id="interface-heading">Interface &amp; Design Projects.</h2></div><p>Websites, digital experiences, brand systems and development contributions.</p></div>
      <div class="project-grid work-page-project-grid">{classic.map((project,i)=><ProjectCard project={project} index={i+1} />)}</div>
    </section>
    <section class="portfolio-work-group" data-project-section id="social-clients" aria-labelledby="social-heading">
      <div class="social-work-heading"><div><span class="eyebrow">02 / CORE SOCIAL CLIENTS</span><h2 id="social-heading">Social Media Across Industries.</h2></div><p>Explore individual client campaigns, visual direction and selected creatives.</p></div>
      <div class="social-client-grid">{core.map(project=><SocialClientCard project={project}/>)}</div>
    </section>
    <section class="portfolio-work-group" data-project-section aria-labelledby="brands-heading">
      <div class="social-work-heading"><div><span class="eyebrow">03 / ADDITIONAL BRANDS</span><h2 id="brands-heading">More Brands, More Perspectives.</h2></div><p>Campaign profiles from beauty, food, business services and product categories.</p></div>
      <div class="social-client-grid">{more.map(project=><SocialClientCard project={project}/>)}</div>
    </section>
    <p class="work-no-results" id="workNoResults" hidden>No projects match these filters. Try another industry or reset your selection.</p>
  </div></section>
  <CallToAction />
  <details class="work-filter-dock" id="workFilterDock">
    <summary class="work-filter-trigger">
      <span class="work-filter-symbol" aria-hidden="true">⌗</span>
      <span class="work-filter-trigger-text"><strong>Filter Portfolio</strong><small id="filterCount" aria-live="polite">{projects.length} Projects</small></span>
      <span class="work-filter-chevron" aria-hidden="true">⌃</span>
    </summary>
    <div class="work-filter-sheet" aria-label="Portfolio filters">
      <div class="work-filter-sheet-head"><span class="eyebrow">REFINE YOUR VIEW</span><button id="workFilterReset" type="button">Reset All</button></div>
      <div class="work-filter-section"><span class="work-filter-heading">Discipline</span>
        <div class="work-filter-options" role="group" aria-label="Filter by discipline">
          <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">All Work</button>
          <button type="button" class="filter-btn" data-filter="ui" aria-pressed="false">UI/UX</button>
          <button type="button" class="filter-btn" data-filter="social" aria-pressed="false">Social Media</button>
          <button type="button" class="filter-btn" data-filter="dev" aria-pressed="false">Development</button>
        </div>
      </div>
      <div class="work-filter-section"><span class="work-filter-heading">Industry</span>
        <div class="work-filter-options" role="group" aria-label="Filter by industry">
          {industryFilters.map(item=><button type="button" class:list={['filter-btn',{active:item.id==='all'}]} data-industry-filter={item.id} aria-pressed={item.id==='all'?'true':'false'}>{item.label}</button>)}
        </div>
      </div>
      <div class="work-filter-section"><label class="work-filter-heading" for="projectSearch">Search</label><input id="projectSearch" class="search-field" type="search" placeholder="Client, design skill or industry…" autocomplete="off"/></div>
      <button type="button" class="work-filter-show" id="workFilterDone">Show Matching Projects ↓</button>
    </div>
  </details>
</BaseLayout>