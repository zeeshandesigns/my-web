---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The requested page couldn't be found in Zeeshan Haider's portfolio." noindex={true}>
  <section class="page-hero not-found"><div class="container">
    <span class="eyebrow">404 / PAGE NOT FOUND</span>
    <h1 class="page-title">A Wrong Turn. <span class="soft">It Happens.</span></h1>
    <p class="page-lead">The page you followed may have moved, or its address might be incorrect. You can head back to the homepage or browse the work.</p>
    <div class="hero-buttons"><a class="btn btn-blue" href="/">Back to home ↗</a><a class="btn btn-ghost" href="/work/">Explore work →</a></div>
  </div></section>
</BaseLayout>
